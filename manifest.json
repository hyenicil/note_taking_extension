{
  "manifest_version": 3,
  "name": "Not Alma Uzantısı",
  "version": "1.0",
  "description": "Basit not alma uzantısı",
  "permissions": ["sidePanel", "storage"],
  "action": {},
  "side_panel" : {
    "default_path": "popup.html"
  },
  "background" : {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}